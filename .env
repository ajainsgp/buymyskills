# Environment variables for the backend server (server/index.js loads these via dotenv).
# Restart the server after changing this file.

# REQUIRED for using the Admin Categories page (/admin/categories):
# Set a strong secret value. Use the same key in the Admin UI field to authenticate.
ADMIN_API_KEY=Welcome1234!

# Server port (optional; defaults to 4000)
PORT=4000

# CORS: lock the API to your frontend origin in non-dev environments (optional)
# FRONTEND_ORIGIN=http://localhost:3000

# Persistence mode:
# Leave unset (default) to use filesystem JSON under /data.
# Set one of the following for MySQL mode:
# PERSISTENCE=mysql
USE_DB=true

# MySQL connection (only needed if using MySQL persistence)
DB_HOST=127.0.0.1
DB_PORT=13306
DB_USER=admin
DB_PASSWORD=ACSPass1234!
DB_NAME=buymyskills
# DB_POOL_SIZE=10
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

# Optional: Force HTTPS behind a proxy/load balancer (off by default)
# FORCE_HTTPS=true
# ENABLE_HSTS=true

# Frontend override (optional): By default the frontend calls http://<host>:4000
# You can override that by setting this for the React app (requires restarting 'npm start'):
# REACT_APP_API_BASE_URL=http://localhost:4000

# Session timeout in minutes (default: 15)
REACT_APP_SESSION_TIMEOUT=15

# Email configuration for user confirmation
EMAIL_HOST=sgc49.buymyskills.com
EMAIL_PORT=465
EMAIL_SECURE=false
EMAIL_USER=33e8db604e8feaf66540
EMAIL_PASS=VBLMmoN948JERbSaG1OI
EMAIL_FROM=your-email@gmail.com

# SendGrid configuration for email verification
SENDGRID_API_KEY=SG.placeholder
EMAIL_VERIFICATION_ENABLED=false
